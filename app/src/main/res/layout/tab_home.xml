<?xml version="1.0" encoding="utf-8"?>
<!-- HOME: what's on your screen now, quick actions, what's coming up. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto Wallpaper"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <com.google.android.material.chip.Chip
                android:id="@+id/statusChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                app:chipIconVisible="true" />
        </LinearLayout>

        <!-- Update available -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/updateCard"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_download"
                        app:tint="?attr/colorOnTertiaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/updateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnTertiaryContainer" />

                        <TextView
                            android:id="@+id/updateNotes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnTertiaryContainer"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Update" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/updateProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:visibility="gone"
                    app:trackCornerRadius="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Not set as wallpaper yet -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/setupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One last step"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/setupText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Set Auto Wallpaper as your wallpaper and choose “Home screen and lock screen”."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Set as wallpaper"
                    app:icon="@drawable/ic_wallpaper" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Phone preview -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/phone"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="184dp"
                android:layout_height="456dp"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="6dp">

                <ImageView
                    android:id="@+id/heroPlaceholder"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:alpha="0.5"
                    android:src="@drawable/ic_image"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <com.varadha.autowallpaper.FramedImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Current wallpaper" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="44dp">

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEE, d MMM"
                        android:format24Hour="EEE, d MMM"
                        android:shadowColor="#99000000"
                        android:shadowRadius="6"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:format12Hour="h:mm"
                        android:format24Hour="H:mm"
                        android:shadowColor="#99000000"
                        android:shadowRadius="8"
                        android:textColor="@android:color/white"
                        android:textSize="46sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/heroSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Quick actions -->
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/HomeAction">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/HomeActionButton"
                    android:contentDescription="Edit"
                    app:icon="@drawable/ic_crop" />

                <TextView
                    style="@style/HomeActionLabel"
                    android:text="Edit" />
            </LinearLayout>

            <LinearLayout style="@style/HomeAction">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/HomeActionButton"
                    android:contentDescription="Next photo"
                    app:icon="@drawable/ic_skip_next" />

                <TextView
                    style="@style/HomeActionLabel"
                    android:text="Next" />
            </LinearLayout>

            <LinearLayout style="@style/HomeAction">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFav"
                    style="@style/HomeActionButton"
                    android:contentDescription="Favourite"
                    app:icon="@drawable/ic_favorite_border" />

                <TextView
                    android:id="@+id/favLabel"
                    style="@style/HomeActionLabel"
                    android:text="Favourite" />
            </LinearLayout>

            <LinearLayout style="@style/HomeAction">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMore"
                    style="@style/HomeActionButton"
                    android:contentDescription="More options"
                    app:icon="@drawable/ic_more_horiz" />

                <TextView
                    style="@style/HomeActionLabel"
                    android:text="More" />
            </LinearLayout>
        </LinearLayout>

        <!-- Coming up -->
        <LinearLayout
            android:id="@+id/upNextBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                style="@style/SectionLabel"
                android:text="Coming up" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/upNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- How it changes (tap to open settings) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summaryCard"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_autorenew"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/summaryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:id="@+id/summaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Empty state -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="Add your photos"
            android:visibility="gone"
            app:icon="@drawable/ic_add" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
