<?xml version="1.0" encoding="utf-8"?>
<!-- Options for one photo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Preview + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="72dp"
            android:layout_height="152dp"
            app:cardCornerRadius="14dp">

            <com.varadha.autowallpaper.FramedImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                android:id="@+id/sheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/boxShow"
            style="@style/HomeAction">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionShow"
                style="@style/HomeActionButton"
                android:contentDescription="Show now"
                app:icon="@drawable/ic_wallpaper" />

            <TextView
                style="@style/HomeActionLabel"
                android:text="Show now" />
        </LinearLayout>

        <LinearLayout style="@style/HomeAction">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionAdjust"
                style="@style/HomeActionButton"
                android:contentDescription="Edit"
                app:icon="@drawable/ic_crop" />

            <TextView
                style="@style/HomeActionLabel"
                android:text="Edit" />
        </LinearLayout>

        <LinearLayout style="@style/HomeAction">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionFav"
                style="@style/HomeActionButton"
                android:contentDescription="Favourite"
                app:icon="@drawable/ic_favorite_border" />

            <TextView
                android:id="@+id/actionFavLabel"
                style="@style/HomeActionLabel"
                android:text="Favourite" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/actionFit"
        style="@style/SheetAction"
        android:drawableStart="@drawable/ic_fit_screen"
        android:text="Fit whole photo" />

    <TextView
        android:id="@+id/actionLayout"
        style="@style/SheetAction"
        android:drawableStart="@drawable/ic_view_agenda"
        android:text="Layout: repeat 2× or 3×" />

    <TextView
        android:id="@+id/actionFace"
        style="@style/SheetAction"
        android:drawableStart="@drawable/ic_face"
        android:text="Auto-frame faces" />

    <TextView
        android:id="@+id/actionRemove"
        style="@style/SheetAction"
        android:drawableStart="@drawable/ic_delete"
        android:text="Remove from rotation"
        android:textColor="?attr/colorError"
        app:drawableTint="?attr/colorError" />
</LinearLayout>
