<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- Only used by the app screen to check GitHub for a newer version. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: install the new version over this app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Auto Wallpaper"
        android:theme="@style/Theme.AutoWallpaper">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AdjustActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AutoWallpaper.Adjust" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <service
            android:name=".NextTileService"
            android:exported="true"
            android:icon="@drawable/ic_skip_next"
            android:label="Next wallpaper"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".AutoWallpaperService"
            android:exported="true"
            android:label="Auto Wallpaper"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
